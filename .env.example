# Public Supabase Auth configuration. These values are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged runtime key. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Keep enabled only when quiz/flashcard write APIs should persist user learning data.
ENABLE_PERSONAL_WRITES=true
